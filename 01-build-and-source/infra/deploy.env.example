# deploy-ecs.sh 가 읽는 계정 설정. 이 파일을 `deploy.env`로 복사해 채운다.
#
# 왜 파일을 나누는가: 계정 ID·CloudFront 배포 ID는 비밀은 아니지만 **우리 계정을
# 가리키는 값**이다. 스크립트에 박아 두면 포크한 사람이 자기 계정으로 배포할 수
# 없고, 우리 자원 이름이 공개 레포에 남는다. `deploy.env`는 .gitignore에 있다.
#
# 자원 자체를 처음 만드는 절차는 infra/README.md 참조.

# 12자리 AWS 계정 번호 — ECR 주소를 만드는 데 쓴다
AWS_ACCOUNT_ID=
# 배포에 쓸 프로파일·리전 (비우면 default / ap-northeast-2)
AWS_PROFILE=
AWS_REGION=ap-northeast-2

# ECS
ECS_CLUSTER=
ECS_SERVICE=
# ECR 리포지토리 이름 (계정 주소는 AWS_ACCOUNT_ID로 조립된다)
ECR_REPO=

# CloudFront 배포 ID — 배포 후 index.html 구버전이 남지 않게 무효화한다
CLOUDFRONT_DIST_ID=

# 배포 완료 로그에 찍을 주소 (선택)
PUBLIC_URL=
